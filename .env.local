# Evaluna ERP Environment Configuration

# Server variables (packages/env/src/server.ts)
# Optional: The project currently defaults to a local PGLite database at './data/pglite' if this is missing.
# If you plan to connect to an external PostgreSQL database, provide the connection string here:
DATABASE_URL="postgresql://user:password@aws-eu-central-1.pooler.supabase.com:6543/postgres"

# Better Auth Configuration (Required for Sessions)
# Generate a strong 32-character random string for production
BETTER_AUTH_SECRET=9288e9e8bbe9983f9874eb13f6bb1c1b86de48029bbd5328754b14db14575c27
BETTER_AUTH_URL=http://localhost:3001

# Server-Side Base URL
BASE_URL=http://localhost

# Optional: Set this to restrict API access from other domains
# CORS_ORIGIN=http://localhost:3000

# Client variables (packages/env/src/web.ts)
NEXT_PUBLIC_BASE_URL=http://localhost

# Node Environment
NODE_ENV=development

# --- Upcoming Production APIs (Placeholders) ---

# Payment Gateway (e.g., Stripe, Pagar.me)
# PAYMENT_GATEWAY_PUBLIC_KEY=your_public_key
# PAYMENT_GATEWAY_SECRET_KEY=your_secret_key
# PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# Fiscal & Tax Compliance (Brazil SEFAZ)
# SEFAZ_API_CERTIFICATE_PATH=path/to/certificate.pfx
# SEFAZ_API_PASSWORD=certificate_password
# SEFAZ_ENVIRONMENT=homologacao

# Communications (SMS & Email)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token


// For Production, you will eventually need:

// A Production Database URL: A standard PostgreSQL connection string (e.g., Supabase or AWS RDS).
// Fiscal/Tax APIs (SEFAZ): I noticed deep architectural integrations for Brazilian NFC-e/NF-e tax compliance. To make this work in production, you will need to provide your A1 Digital Certificate path and password.
// Payment & Communication APIs: Keys for whatever payment processor you choose (like Stripe/Pagar.me) and communication APIs (like SendGrid for email receipts or Twilio for SMS delivery updates).