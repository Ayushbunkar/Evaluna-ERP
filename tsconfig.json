{
	"extends": "@evaluna/config/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"paths": {
			"@/*": ["./packages/ui/src/*"],
			"@evaluna/ui/*": ["./packages/ui/src/*"]
